#include <stdio.h>
#include <string.h>
 
int main() 
{
    char name[100];
    char ch;
    printf("Enter a single character");
    ch = getchar();
    printf("You entered the character = %c\n", ch);
    while (getchar() != '\n');
    name[strcspn(name, "")] = '\0';
    printf("Registration completed of user");
    puts(name);
 
    return 0;
}
